    {
      "name": "💚 M-Pesa API (Daraja)",
      "item": [
        {
          "name": "Initiate STK Push (JSON API)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/mpesa/initiate",
            "body": { "mode": "raw", "raw": "{\n  \"invoice_id\": 1,\n  \"phone\": \"0712345678\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Initiates M-Pesa STK Push via Daraja API. Returns checkout_request_id for polling."
          }
        },
        {
          "name": "Query STK Push Status",
          "request": { "method": "GET", "url": "{{base_url}}/api/mpesa/stk-query/{{checkout_request_id}}",
            "description": "Query Safaricom for current status of a pending STK Push transaction." }
        },
        {
          "name": "M-Pesa Callback (Safaricom → App)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/mpesa/callback",
            "body": { "mode": "raw", "raw": "{\n  \"Body\": {\n    \"stkCallback\": {\n      \"MerchantRequestID\": \"29115-34620561-1\",\n      \"CheckoutRequestID\": \"ws_CO_191220191020363925\",\n      \"ResultCode\": 0,\n      \"ResultDesc\": \"The service request is processed successfully.\",\n      \"CallbackMetadata\": {\n        \"Item\": [\n          { \"Name\": \"Amount\", \"Value\": 28800 },\n          { \"Name\": \"MpesaReceiptNumber\", \"Value\": \"NLJ7RT61SV\" },\n          { \"Name\": \"TransactionDate\", \"Value\": 20240405132345 },\n          { \"Name\": \"PhoneNumber\", \"Value\": 254712345678 }\n        ]\n      }\n    }\n  }\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Safaricom POSTs this to our callback URL after payment. No auth needed — Safaricom initiates. Auto-generates receipt and SMS on success."
          }
        },
        {
          "name": "M-Pesa Callback — Failed Payment",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/mpesa/callback",
            "body": { "mode": "raw", "raw": "{\n  \"Body\": {\n    \"stkCallback\": {\n      \"MerchantRequestID\": \"29115-34620561-2\",\n      \"CheckoutRequestID\": \"ws_CO_191220191020363926\",\n      \"ResultCode\": 1032,\n      \"ResultDesc\": \"Request cancelled by user.\"\n    }\n  }\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        }
      ]
    },
