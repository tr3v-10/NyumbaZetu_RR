{
  "info": {
    "_postman_id": "nyumba-manager-api-v1",
    "name": "NyumbaManager API — Full Collection",
    "description": "Complete API collection for NyumbaManager — Kenya House Management System.\n\nIncludes: Authentication, Super Admin, Landlord, Tenant, Caretaker, Agent, M-Pesa, Bank, and Utility endpoints.\n\n**Setup:**\n1. Set `base_url` variable to your server URL (e.g. http://localhost:5000)\n2. Login via the Auth endpoints to get a session cookie\n3. All state-changing requests require the CSRF token from the login response meta tag\n\n**Kenya-specific notes:**\n- All monetary values are in KES (Kenyan Shillings)\n- M-Pesa phone numbers should be in format 254XXXXXXXXX\n- Payment references follow format NYM{property_id:04d}{unit_number}",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:5000", "type": "string" },
    { "key": "csrf_token", "value": "", "type": "string" },
    { "key": "landlord_id", "value": "1", "type": "string" },
    { "key": "property_id", "value": "1", "type": "string" },
    { "key": "unit_id", "value": "1", "type": "string" },
    { "key": "lease_id", "value": "1", "type": "string" },
    { "key": "invoice_id", "value": "1", "type": "string" },
    { "key": "user_id", "value": "1", "type": "string" },
    { "key": "maintenance_id", "value": "1", "type": "string" },
    { "key": "checkout_request_id", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "🔐 Authentication",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST", "header": [{ "key": "Content-Type", "value": "application/x-www-form-urlencoded" }],
            "url": "{{base_url}}/auth/login",
            "body": { "mode": "urlencoded", "urlencoded": [
              { "key": "email", "value": "admin@nyumba.ke" },
              { "key": "password", "value": "SecurePass123!" },
              { "key": "remember", "value": "on" },
              { "key": "csrf_token", "value": "{{csrf_token}}" }
            ]},
            "description": "Login with email and password. Session cookie is returned."
          }
        },
        {
          "name": "Register — Tenant",
          "request": {
            "method": "POST", "header": [{ "key": "Content-Type", "value": "application/x-www-form-urlencoded" }],
            "url": "{{base_url}}/auth/register",
            "body": { "mode": "urlencoded", "urlencoded": [
              { "key": "email", "value": "newtenant@example.co.ke" },
              { "key": "first_name", "value": "John" },
              { "key": "last_name", "value": "Kamau" },
              { "key": "phone", "value": "0712345678" },
              { "key": "password", "value": "SecurePass123!" },
              { "key": "confirm_password", "value": "SecurePass123!" },
              { "key": "role", "value": "tenant" },
              { "key": "terms", "value": "on" },
              { "key": "privacy", "value": "on" },
              { "key": "csrf_token", "value": "{{csrf_token}}" }
            ]},
            "description": "Register a new tenant account."
          }
        },
        {
          "name": "Register — Landlord",
          "request": {
            "method": "POST", "header": [{ "key": "Content-Type", "value": "application/x-www-form-urlencoded" }],
            "url": "{{base_url}}/auth/register",
            "body": { "mode": "urlencoded", "urlencoded": [
              { "key": "email", "value": "landlord@example.co.ke" },
              { "key": "first_name", "value": "Grace" },
              { "key": "last_name", "value": "Wanjiku" },
              { "key": "phone", "value": "0722345678" },
              { "key": "password", "value": "SecurePass123!" },
              { "key": "confirm_password", "value": "SecurePass123!" },
              { "key": "role", "value": "landlord" },
              { "key": "terms", "value": "on" },
              { "key": "privacy", "value": "on" },
              { "key": "csrf_token", "value": "{{csrf_token}}" }
            ]}
          }
        },
        {
          "name": "Forgot Password",
          "request": {
            "method": "POST", "header": [{ "key": "Content-Type", "value": "application/x-www-form-urlencoded" }],
            "url": "{{base_url}}/auth/forgot-password",
            "body": { "mode": "urlencoded", "urlencoded": [
              { "key": "email", "value": "user@example.co.ke" },
              { "key": "csrf_token", "value": "{{csrf_token}}" }
            ]}
          }
        },
        {
          "name": "Logout",
          "request": { "method": "GET", "url": "{{base_url}}/auth/logout" }
        }
      ]
    },
    {
      "name": "🔴 Super Admin",
      "item": [
        {
          "name": "Dashboard",
          "request": { "method": "GET", "url": "{{base_url}}/admin/dashboard",
            "description": "Returns system-wide stats including users, properties, revenue, visitor counts." }
        },
        {
          "name": "List Users",
          "request": { "method": "GET", "url": { "raw": "{{base_url}}/admin/users?page=1&role=landlord&search=&status=active",
            "query": [
              { "key": "page", "value": "1" }, { "key": "role", "value": "landlord" },
              { "key": "search", "value": "" }, { "key": "status", "value": "active" }
            ], "host": ["{{base_url}}"], "path": ["admin", "users"] }}
        },
        {
          "name": "User Detail",
          "request": { "method": "GET", "url": "{{base_url}}/admin/users/{{user_id}}" }
        },
        {
          "name": "Toggle User Active",
          "request": {
            "method": "POST", "header": [{ "key": "Content-Type", "value": "application/x-www-form-urlencoded" }],
            "url": "{{base_url}}/admin/users",
            "body": { "mode": "urlencoded", "urlencoded": [
              { "key": "user_id", "value": "{{user_id}}" },
              { "key": "action", "value": "toggle_active" },
              { "key": "csrf_token", "value": "{{csrf_token}}" }
            ]}
          }
        },
        {
          "name": "Visitor Logs",
          "request": { "method": "GET", "url": { "raw": "{{base_url}}/admin/visitors?page=1&ip=&country=Kenya",
            "query": [{ "key": "page", "value": "1" }, { "key": "ip", "value": "" }, { "key": "country", "value": "Kenya" }],
            "host": ["{{base_url}}"], "path": ["admin", "visitors"] },
            "description": "Forensic visitor logs — IP, MAC, user-agent, geolocation, fingerprint." }
        },
        {
          "name": "Visitor Detail",
          "request": { "method": "GET", "url": "{{base_url}}/admin/visitors/1" }
        },
        {
          "name": "Audit Logs",
          "request": { "method": "GET", "url": "{{base_url}}/admin/audit-logs?page=1" }
        },
        {
          "name": "All Properties",
          "request": { "method": "GET", "url": "{{base_url}}/admin/properties?search=" }
        },
        {
          "name": "System Financials",
          "request": { "method": "GET", "url": "{{base_url}}/admin/financials?year=2024" }
        },
        {
          "name": "Broadcast Announcement",
          "request": {
            "method": "POST", "header": [{ "key": "Content-Type", "value": "application/x-www-form-urlencoded" }],
            "url": "{{base_url}}/admin/announcements",
            "body": { "mode": "urlencoded", "urlencoded": [
              { "key": "title", "value": "System Maintenance Tonight" },
              { "key": "message", "value": "NyumbaManager will be under maintenance 11PM–1AM EAT. All services will resume normally." },
              { "key": "send_sms", "value": "on" },
              { "key": "csrf_token", "value": "{{csrf_token}}" }
            ]},
            "description": "Broadcast to ALL users system-wide with optional SMS via Africa's Talking." }
        },
        {
          "name": "SMS Logs",
          "request": { "method": "GET", "url": "{{base_url}}/admin/sms-logs?page=1" }
        },
        {
          "name": "Promote to Super Admin",
          "request": {
            "method": "POST", "header": [{ "key": "Content-Type", "value": "application/x-www-form-urlencoded" }],
            "url": "{{base_url}}/admin/create-admin",
            "body": { "mode": "urlencoded", "urlencoded": [
              { "key": "user_id", "value": "{{user_id}}" },
              { "key": "csrf_token", "value": "{{csrf_token}}" }
            ]}
          }
        },
        {
          "name": "Super Admin Stats (JSON)",
          "request": { "method": "GET", "url": "{{base_url}}/api/stats/super-admin",
            "description": "JSON API endpoint returning system stats for charts." }
        }
      ]
    },
    {
      "name": "🏘 Landlord Portal",
      "item": [
        {
          "name": "Dashboard",
          "request": { "method": "GET", "url": { "raw": "{{base_url}}/landlord/dashboard?year=2024&month=3",
            "query": [{ "key": "year", "value": "2024" }, { "key": "month", "value": "3" }],
            "host": ["{{base_url}}"], "path": ["landlord", "dashboard"] }}
        },
        {
          "name": "List Properties",
          "request": { "method": "GET", "url": "{{base_url}}/landlord/properties" }
        },
        {
          "name": "Create Property",
          "request": {
            "method": "POST", "header": [{ "key": "Content-Type", "value": "application/x-www-form-urlencoded" }],
            "url": "{{base_url}}/landlord/properties",
            "body": { "mode": "urlencoded", "urlencoded": [
              { "key": "name", "value": "Sunrise Court" },
              { "key": "property_type", "value": "apartment_block" },
              { "key": "county", "value": "Nairobi" },
              { "key": "sub_county", "value": "Kilimani" },
              { "key": "street_address", "value": "Off Argwings Kodhek Road, Kilimani" },
              { "key": "mpesa_paybill", "value": "400200" },
              { "key": "mpesa_account_name", "value": "Sunrise Rent" },
              { "key": "bank_name", "value": "Equity Bank" },
              { "key": "bank_account_number", "value": "1234567890123" },
              { "key": "bank_branch", "value": "Kilimani" },
              { "key": "csrf_token", "value": "{{csrf_token}}" }
            ]}
          }
        },
        {
          "name": "Property Detail",
          "request": { "method": "GET", "url": "{{base_url}}/landlord/properties/{{property_id}}" }
        },
        {
          "name": "Add Unit",
          "request": {
            "method": "POST", "header": [{ "key": "Content-Type", "value": "application/x-www-form-urlencoded" }],
            "url": "{{base_url}}/landlord/properties/{{property_id}}/units",
            "body": { "mode": "urlencoded", "urlencoded": [
              { "key": "unit_number", "value": "B3" },
              { "key": "unit_type", "value": "2br" },
              { "key": "rent_amount", "value": "28000" },
              { "key": "deposit_amount", "value": "56000" },
              { "key": "service_charge", "value": "500" },
              { "key": "water_charge", "value": "0" },
              { "key": "garbage_charge", "value": "300" },
              { "key": "bedrooms", "value": "2" },
              { "key": "bathrooms", "value": "2" },
              { "key": "floor", "value": "3" },
              { "key": "rent_due_day", "value": "5" },
              { "key": "csrf_token", "value": "{{csrf_token}}" }
            ]}
          }
        },
        {
          "name": "List Units",
          "request": { "method": "GET", "url": "{{base_url}}/landlord/properties/{{property_id}}/units" }
        },
        {
          "name": "Create Lease",
          "request": {
            "method": "POST", "header": [{ "key": "Content-Type", "value": "application/x-www-form-urlencoded" }],
            "url": "{{base_url}}/landlord/leases/create",
            "body": { "mode": "urlencoded", "urlencoded": [
              { "key": "unit_id", "value": "{{unit_id}}" },
              { "key": "tenant_email", "value": "tenant@example.co.ke" },
              { "key": "start_date", "value": "2024-04-01" },
              { "key": "end_date", "value": "2025-03-31" },
              { "key": "rent_amount", "value": "28000" },
              { "key": "deposit_amount", "value": "56000" },
              { "key": "service_charge", "value": "500" },
              { "key": "water_charge", "value": "0" },
              { "key": "garbage_charge", "value": "300" },
              { "key": "notice_period_days", "value": "30" },
              { "key": "number_of_occupants", "value": "2" },
              { "key": "pets_allowed", "value": "off" },
              { "key": "special_conditions", "value": "No parties after 10PM" },
              { "key": "csrf_token", "value": "{{csrf_token}}" }
            ]},
            "description": "Creates lease and notifies tenant via in-app notification."
          }
        },
        {
          "name": "List Leases",
          "request": { "method": "GET", "url": "{{base_url}}/landlord/leases?status=active" }
        },
        {
          "name": "Lease Detail",
          "request": { "method": "GET", "url": "{{base_url}}/landlord/leases/{{lease_id}}" }
        },
        {
          "name": "Generate Monthly Invoices",
          "request": {
            "method": "POST", "header": [{ "key": "Content-Type", "value": "application/x-www-form-urlencoded" }],
            "url": "{{base_url}}/landlord/invoices/generate",
            "body": { "mode": "urlencoded", "urlencoded": [
              { "key": "month", "value": "4" },
              { "key": "year", "value": "2024" },
              { "key": "csrf_token", "value": "{{csrf_token}}" }
            ]},
            "description": "Bulk generates rent invoices for all active leases and sends SMS reminders."
          }
        },
        {
          "name": "List Invoices",
          "request": { "method": "GET", "url": "{{base_url}}/landlord/invoices?status=overdue" }
        },
        {
          "name": "Record Manual Payment (Cash/Cheque)",
          "request": {
            "method": "POST", "header": [{ "key": "Content-Type", "value": "application/x-www-form-urlencoded" }],
            "url": "{{base_url}}/landlord/payments/record",
            "body": { "mode": "urlencoded", "urlencoded": [
              { "key": "invoice_id", "value": "{{invoice_id}}" },
              { "key": "amount", "value": "28800" },
              { "key": "payment_method", "value": "cash" },
              { "key": "notes", "value": "Cash paid at caretaker office" },
              { "key": "csrf_token", "value": "{{csrf_token}}" }
            ]}
          }
        },
        {
          "name": "List Payments",
          "request": { "method": "GET", "url": "{{base_url}}/landlord/payments?method=mpesa" }
        },
        {
          "name": "Maintenance Requests (Landlord)",
          "request": { "method": "GET", "url": "{{base_url}}/landlord/maintenance?status=awaiting_approval" }
        },
        {
          "name": "Approve Purchase Request",
          "request": {
            "method": "POST", "header": [{ "key": "Content-Type", "value": "application/x-www-form-urlencoded" }],
            "url": "{{base_url}}/landlord/maintenance/{{maintenance_id}}/approve-purchase",
            "body": { "mode": "urlencoded", "urlencoded": [
              { "key": "purchase_id", "value": "1" },
              { "key": "action", "value": "approve" },
              { "key": "notes", "value": "Approved. Use petty cash." },
              { "key": "csrf_token", "value": "{{csrf_token}}" }
            ]}
          }
        },
        {
          "name": "Reject Purchase Request",
          "request": {
            "method": "POST", "header": [{ "key": "Content-Type", "value": "application/x-www-form-urlencoded" }],
            "url": "{{base_url}}/landlord/maintenance/{{maintenance_id}}/approve-purchase",
            "body": { "mode": "urlencoded", "urlencoded": [
              { "key": "purchase_id", "value": "1" },
              { "key": "action", "value": "reject" },
              { "key": "notes", "value": "Get a cheaper quote first." },
              { "key": "csrf_token", "value": "{{csrf_token}}" }
            ]}
          }
        },
        {
          "name": "Record Expense",
          "request": {
            "method": "POST", "header": [{ "key": "Content-Type", "value": "application/x-www-form-urlencoded" }],
            "url": "{{base_url}}/landlord/expenses",
            "body": { "mode": "urlencoded", "urlencoded": [
              { "key": "property_id", "value": "{{property_id}}" },
              { "key": "category", "value": "maintenance" },
              { "key": "description", "value": "Replaced kitchen sink tap Unit B3" },
              { "key": "amount", "value": "1500" },
              { "key": "expense_date", "value": "2024-04-05" },
              { "key": "payment_method", "value": "mpesa" },
              { "key": "vendor_name", "value": "ABC Hardware Westlands" },
              { "key": "csrf_token", "value": "{{csrf_token}}" }
            ]}
          }
        },
        {
          "name": "Financial Reports",
          "request": { "method": "GET", "url": "{{base_url}}/landlord/reports?year=2024" }
        },
        {
          "name": "Send Property Announcement",
          "request": {
            "method": "POST", "header": [{ "key": "Content-Type", "value": "application/x-www-form-urlencoded" }],
            "url": "{{base_url}}/landlord/announcements",
            "body": { "mode": "urlencoded", "urlencoded": [
              { "key": "property_id", "value": "{{property_id}}" },
              { "key": "title", "value": "Water Shutdown — Thursday 8AM–12PM" },
              { "key": "message", "value": "Dear residents, Nairobi Water will shut off supply on Thursday 8AM–12PM for maintenance. Please store water in advance. Apologies for the inconvenience." },
              { "key": "type", "value": "utility" },
              { "key": "send_sms", "value": "on" },
              { "key": "csrf_token", "value": "{{csrf_token}}" }
            ]},
            "description": "Sends announcement to all tenants in the property via in-app and optional SMS."
          }
        },
        {
          "name": "Landlord Stats (JSON)",
          "request": { "method": "GET", "url": "{{base_url}}/api/stats/landlord?year=2024&month=4" }
        }
      ]
    },
    {
      "name": "🔑 Tenant Portal",
      "item": [
        {
          "name": "Dashboard",
          "request": { "method": "GET", "url": "{{base_url}}/tenant/dashboard" }
        },
        {
          "name": "My Invoices",
          "request": { "method": "GET", "url": "{{base_url}}/tenant/invoices" }
        },
        {
          "name": "Pay Invoice (M-Pesa STK Push)",
          "request": {
            "method": "POST", "header": [{ "key": "Content-Type", "value": "application/x-www-form-urlencoded" }],
            "url": "{{base_url}}/tenant/pay/{{invoice_id}}",
            "body": { "mode": "urlencoded", "urlencoded": [
              { "key": "method", "value": "mpesa" },
              { "key": "phone", "value": "0712345678" },
              { "key": "csrf_token", "value": "{{csrf_token}}" }
            ]},
            "description": "Initiates Safaricom STK Push. Money flows directly tenant M-Pesa → landlord Paybill."
          }
        },
        {
          "name": "Pay Invoice (Bank Transfer Reference)",
          "request": {
            "method": "POST", "header": [{ "key": "Content-Type", "value": "application/x-www-form-urlencoded" }],
            "url": "{{base_url}}/tenant/pay/{{invoice_id}}",
            "body": { "mode": "urlencoded", "urlencoded": [
              { "key": "method", "value": "bank" },
              { "key": "csrf_token", "value": "{{csrf_token}}" }
            ]},
            "description": "Returns bank account details + unique payment reference for reconciliation."
          }
        },
        {
          "name": "Check M-Pesa Payment Status",
          "request": { "method": "GET", "url": "{{base_url}}/tenant/check-payment-status/{{checkout_request_id}}",
            "description": "Poll this endpoint after STK Push to check if tenant has completed payment." }
        },
        {
          "name": "Payment History",
          "request": { "method": "GET", "url": "{{base_url}}/tenant/payments" }
        },
        {
          "name": "Submit Maintenance Request",
          "request": {
            "method": "POST", "header": [{ "key": "Content-Type", "value": "application/x-www-form-urlencoded" }],
            "url": "{{base_url}}/tenant/maintenance",
            "body": { "mode": "urlencoded", "urlencoded": [
              { "key": "title", "value": "Kitchen sink tap leaking badly" },
              { "key": "description", "value": "The kitchen cold water tap has been dripping constantly for 3 days. Water is pooling under the sink cabinet. Urgently needs attention." },
              { "key": "category", "value": "plumbing" },
              { "key": "urgency", "value": "urgent" },
              { "key": "csrf_token", "value": "{{csrf_token}}" }
            ]}
          }
        },
        {
          "name": "Maintenance List",
          "request": { "method": "GET", "url": "{{base_url}}/tenant/maintenance" }
        },
        {
          "name": "Maintenance Detail",
          "request": { "method": "GET", "url": "{{base_url}}/tenant/maintenance/{{maintenance_id}}" }
        },
        {
          "name": "Send Maintenance Message",
          "request": {
            "method": "POST", "header": [{ "key": "Content-Type", "value": "application/x-www-form-urlencoded" }],
            "url": "{{base_url}}/tenant/maintenance/{{maintenance_id}}/message",
            "body": { "mode": "urlencoded", "urlencoded": [
              { "key": "message", "value": "Any update on the plumber? Still leaking this morning." },
              { "key": "csrf_token", "value": "{{csrf_token}}" }
            ]}
          }
        },
        {
          "name": "Rate Completed Maintenance",
          "request": {
            "method": "POST", "header": [{ "key": "Content-Type", "value": "application/x-www-form-urlencoded" }],
            "url": "{{base_url}}/tenant/maintenance/{{maintenance_id}}/rate",
            "body": { "mode": "urlencoded", "urlencoded": [
              { "key": "rating", "value": "5" },
              { "key": "feedback", "value": "Peter was very professional and fixed it quickly. Thank you!" },
              { "key": "csrf_token", "value": "{{csrf_token}}" }
            ]}
          }
        },
        {
          "name": "Configure Auto-Pay",
          "request": {
            "method": "POST", "header": [{ "key": "Content-Type", "value": "application/x-www-form-urlencoded" }],
            "url": "{{base_url}}/tenant/auto-pay",
            "body": { "mode": "urlencoded", "urlencoded": [
              { "key": "payment_method", "value": "mpesa" },
              { "key": "mpesa_phone", "value": "0712345678" },
              { "key": "day_of_month", "value": "5" },
              { "key": "csrf_token", "value": "{{csrf_token}}" }
            ]},
            "description": "Schedule automatic M-Pesa STK Push on a specific day each month."
          }
        },
        {
          "name": "Notifications",
          "request": { "method": "GET", "url": "{{base_url}}/tenant/notifications" }
        },
        {
          "name": "My Documents",
          "request": { "method": "GET", "url": "{{base_url}}/tenant/documents" }
        },
        {
          "name": "Send Message",
          "request": {
            "method": "POST", "header": [{ "key": "Content-Type", "value": "application/x-www-form-urlencoded" }],
            "url": "{{base_url}}/tenant/messages",
            "body": { "mode": "urlencoded", "urlencoded": [
              { "key": "recipient_id", "value": "{{landlord_id}}" },
              { "key": "subject", "value": "Lease renewal query" },
              { "key": "message", "value": "Good afternoon. My lease expires in 60 days. Could we discuss renewal terms?" },
              { "key": "csrf_token", "value": "{{csrf_token}}" }
            ]}
          }
        },
        {
          "name": "Update Profile",
          "request": {
            "method": "POST", "header": [{ "key": "Content-Type", "value": "application/x-www-form-urlencoded" }],
